	"Events": [
		{ // engine ignition event
			"name": "Ignition",
			"id": 0,
			"single_fire": true,
			"cooldown": 0,
			"action": [
				{
					"type": "engine",
					"id": 0,
					"param": 1
				}
			],
			"condition": {
				"operator": "MORETHAN",
				"flightVar": "TimeSinceIgnition",
				"threshold": 0
			}
		},
		{ // engine shutdown event
			"name": "Engine shutdown",
			"id": 1,
			"single_fire": true,
			"cooldown": 0,
			"action": [
				{
					"type": "engine",
					"id": 0,
					"param": 0
				}
			],
			"condition": {
				"operator": "MORETHAN",
				"flightVar": "TimeSinceIgnition",
				"threshold": 25000 // burning to depletion regardless - this event is so that solenoids get unpowered
			}
		},
		{ // separation event
			"name": "Separation",
			"id": 2,
			"single_fire": true,
			"cooldown": 0,
			"action": [
				{
					"type": "deployment",
					"id": 0,
					"param": 15000
				}
			],
			"condition": {
				"operator": "MORETHAN",
				"flightVar": "TimeSinceApogee",
				"threshold": 0
			}
		},
