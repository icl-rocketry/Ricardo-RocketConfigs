		{ //Turn deployment rail off 
			"name": "Deployment rail to ready",
			"id": 3,
			"single_fire": true,
			"cooldown": 0,
			"action": [
				{
					"type": "command",
					"destination": 20,
					"command_id": 1,
					"command_arg": 0
				},
				{
					"type": "command",
					"destination": 21,
					"command_id": 1,
					"command_arg": 0
				}
			],
			"condition": {
				"operator": "AND",
				"condition": [
					{
						"operator": "MORETHAN",
						"flightVar": "Position",
						"component": 2,
						"threshold": -200 //200m in NED
					},
					{
						"operator": "MORETHAN",
						"flightVar": "TimeSinceApogee",
						"threshold": 600000 //10 mins
